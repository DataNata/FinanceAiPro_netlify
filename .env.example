# Скопируйте в .env (локальный запуск) — или задайте те же переменные на Netlify:
# Site configuration → Environment variables. Файл .env никуда не загружается.

# ---------- Вход ----------
# Код доступа к сайту (пусто — вход без кода; на Netlify обязательно задайте)
APP_PASSWORD=
# Секрет подписи входа: длинная случайная строка (на Netlify обязательно; смена — выход всех)
SESSION_SECRET=

# ---------- LLM для текстовых выводов ----------
# anthropic | openai | xai | groq | gemini | deepseek | ollama | none (none — текст по шаблону, без LLM)
LLM_PROVIDER=groq
LLM_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

XAI_API_KEY=
XAI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Ollama работает только локально (на Netlify недоступна)
OLLAMA_MODEL=
